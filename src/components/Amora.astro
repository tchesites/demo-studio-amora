---
// Marca do Studio Amora: um cacho de amoras desenhado em SVG.
// Usa currentColor para herdar a cor do contexto.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="11" cy="14" r="4.1" fill="currentColor" />
  <circle cx="17.2" cy="11.4" r="4.1" fill="currentColor" />
  <circle cx="23.2" cy="14" r="4.1" fill="currentColor" />
  <circle cx="13.6" cy="20.4" r="4.1" fill="currentColor" />
  <circle cx="20.2" cy="20.4" r="4.1" fill="currentColor" />
  <circle cx="16.9" cy="25.6" r="3.5" fill="currentColor" />
  <path
    d="M17 8.2c.1-3.1 2.2-5.4 5.5-5.9-.4 3.2-2.4 5.4-5.5 5.9Z"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linejoin="round"
  />
</svg>
