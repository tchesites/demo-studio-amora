---
import { negocio, whatsappLink } from '../data/negocio.js';

interface Props {
  label?: string;
}

const { label = 'Agendar meu horário' } = Astro.props;

const href = whatsappLink(
  `Oi! Vim pelo Instagram e queria agendar um horário no ${negocio.nome}.`
);
---

<a class="cta" href={href} target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <path
      d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.5L3.5 20.5l1.3-4.3A8.5 8.5 0 1 1 20.5 11.7Z"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"
    />
    <path
      d="M9.2 8.3c.3-.6.6-.6.9-.6h.7c.2 0 .5 0 .7.5l.8 1.9c.1.3 0 .5-.2.7l-.6.7c-.2.2-.2.4-.1.6.4.8 1.5 1.9 2.4 2.3.3.1.5.1.7-.1l.7-.8c.2-.2.4-.2.6-.1l1.8.9c.3.1.5.3.5.6 0 .3-.1 1.2-.7 1.8-.6.6-1.4.9-2.4.6-1-.2-2.4-.8-3.9-2.1-1.2-1.1-2-2.4-2.3-3.3-.3-1 0-1.9.3-2.4Z"
      fill="currentColor"
    />
  </svg>
  {label}
</a>
